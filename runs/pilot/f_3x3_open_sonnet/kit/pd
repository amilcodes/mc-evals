#!/usr/bin/env python3
"""pd: command-line client for the piston-door test tools. Run `./pd help`."""
import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent


def server():
    url = os.environ.get("PD_SERVER")
    if not url and (HERE / ".pd_server").exists():
        url = (HERE / ".pd_server").read_text().strip()
    if not url:
        sys.exit("pd: no tool server configured (set PD_SERVER or create .pd_server)")
    return url


def call(tool, **args):
    req = urllib.request.Request(server(), data=json.dumps({"tool": tool, "args": args}).encode(),
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            return json.loads(r.read())["text"]
    except OSError as e:
        sys.exit(f"pd: cannot reach the tool server at {server()}: {e}")


def design(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError) as e:
        sys.exit(f"pd: cannot read design {path}: {e}")


def main():
    ap = argparse.ArgumentParser(prog="pd", description="Piston-door test tools")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="task, remaining budget, best result so far")
    sub.add_parser("blocks", help="the allowed blocks and their properties")
    t = sub.add_parser("test", help="full test of a design: valid or not, volume, timings (uses a test call)")
    t.add_argument("file")
    tr = sub.add_parser("trace", help="every block change tick by tick, after placement and each lever flip")
    tr.add_argument("file")
    tr.add_argument("--flips", type=int, default=2, help="number of lever flips to simulate (default 2)")
    tr.add_argument("--ticks", type=int, help="max ticks to run after each flip (default: the time cap)")
    tr.add_argument("--grep", help="only show change lines containing this text, e.g. piston or '(3,'")
    tr.add_argument("--limit", type=int, default=80, help="max change lines per phase (default 80)")
    v = sub.add_parser("view", help="ASCII picture of the build, one grid per z layer")
    v.add_argument("file")
    v.add_argument("--flips", type=int, default=0, help="show the state after this many lever flips (default 0)")
    v.add_argument("--z", help="only these layers, e.g. 0 or -1..2")
    s = sub.add_parser("submit", help="nominate a design for final scoring (the last submit counts)")
    s.add_argument("file")
    a = ap.parse_args()
    if a.cmd in ("status", "blocks"):
        print(call(a.cmd))
    elif a.cmd == "test":
        print(call("test", design=design(a.file)))
    elif a.cmd == "trace":
        print(call("trace", design=design(a.file), flips=a.flips, ticks=a.ticks, grep=a.grep, limit=a.limit))
    elif a.cmd == "view":
        print(call("view", design=design(a.file), flips=a.flips, z=a.z))
    elif a.cmd == "submit":
        print(call("submit", design=design(a.file)))


if __name__ == "__main__":
    main()
