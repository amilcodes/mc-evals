{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .pdb { display: flex; flex-direction: column; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .pdb-lede { font-size: var(--cds-font-size-heading); line-height: 1.45; max-width: 68ch; margin: 0; }\n  .pdb-lede b { font-weight: var(--cds-font-weight-medium); font-variant-numeric: tabular-nums; }\n  .pdb-sub { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); max-width: 68ch; margin: 0; }\n  .pdb h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0 0 var(--cds-gap-xs); text-wrap: balance; }\n  .pdb-section > p { margin: 0 0 var(--cds-gap-md); color: var(--color-fg-muted); max-width: 70ch; }\n  .pdb-scroll { overflow-x: auto; }\n  .pdb table { border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: var(--cds-font-size-body); min-width: 100%; }\n  .pdb th, .pdb td { padding: var(--cds-pad-xs) var(--cds-pad-sm); text-align: right; white-space: nowrap; border-bottom: 1px solid var(--color-border-line); }\n  .pdb th { font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); letter-spacing: .02em; }\n  .pdb th:first-child, .pdb td:first-child, .pdb th.pdb-l, .pdb td.pdb-l { text-align: left; }\n  .pdb-sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: baseline; }\n  .pdb-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pdb-controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-gap-md); margin-bottom: var(--cds-gap-sm); }\n  .pdb-controls label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pdb-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--cds-gap-lg); min-height: 280px; }\n  .pdb-panel { position: relative; min-width: 0; background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md); }\n  .pdb-panel h3 { margin: 0 0 var(--cds-gap-xs); font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); }\n  .pdb-panel .pdb-note { margin: var(--cds-gap-xs) 0 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pdb-axis text { fill: var(--cds-text-secondary); font-size: var(--cds-font-size-caption); }\n  .pdb-axis path, .pdb-axis line { stroke: var(--cds-chart-axis); }\n  .pdb-grid line { stroke: var(--cds-chart-grid); }\n  .pdb-grid path { display: none; }\n  .pdb-ref { stroke: var(--cds-chart-reference); stroke-dasharray: 4 3; }\n  .pdb-reflabel { fill: var(--cds-text-secondary); font-size: var(--cds-font-size-caption); }\n  .pdb-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); line-height: 1.4; white-space: nowrap; z-index: 2; }\n  .pdb-tip .pdb-muted { color: var(--cds-text-secondary); }\n  .pdb-failed { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .pdb details { color: var(--color-fg-muted); max-width: 72ch; }\n  .pdb details summary { cursor: pointer; color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n  .pdb details li { margin: var(--cds-gap-xs) 0; }\n  [data-dash-source-state=refreshing] { opacity: .5; }\n</style>\n\n<div class=\"pdb\">\n  <div id=\"takeaway\">\n    <p class=\"pdb-lede\">On the 3\u00d73 seamless door, the smallest working door so far is <b data-draw=\"lead-volume\" data-source=\"lead\" data-field=\"volume\" data-row=\"0\">\u2014</b> blocks of bounding box, built by <b data-draw=\"lead-model\" data-source=\"lead\" data-field=\"model\" data-row=\"0\">\u2014</b>. That is <b data-draw=\"lead-score\" data-source=\"lead\" data-field=\"score\" data-row=\"0\">\u2014</b>\u00d7 smaller than the best door the grader had seen before this benchmark. <span data-draw=\"lead-none\" data-source=\"lead\" data-field=\"no_door\" data-row=\"0\">\u2014</span></p>\n    <p class=\"pdb-sub\">Each run is one agent with a time limit (60, 120 or 150 minutes for 2\u00d72, 3\u00d73 and 4\u00d74), building a Minecraft Java 26.3 piston door that the grader runs in the real game engine. Smaller is better. An agent that stops early is told its best volume and asked to continue, up to three times.</p>\n  </div>\n\n  <section class=\"pdb-section\" id=\"by-model\">\n    <h2>Results by model and task</h2>\n    <p>Score is the task's reference volume divided by the final door's volume, so 1 matches the reference and higher is better. A run with no working door scores 0. Costs are what the same tokens would cost at API list prices.</p>\n    <div class=\"pdb-scroll\">\n      <table data-source=\"byModel\" data-row-key=\"task,model\" aria-label=\"Results by model and task\">\n        <thead><tr>\n          <th class=\"pdb-l\" data-field=\"task\">Task</th>\n          <th class=\"pdb-l\" data-field=\"model\">Model</th>\n          <th data-field=\"runs\">Runs</th>\n          <th data-field=\"doors\">Working doors</th>\n          <th data-field=\"best_volume\">Best volume</th>\n          <th data-field=\"best_score\">Best score</th>\n          <th data-field=\"mean_score\">Mean score</th>\n          <th data-field=\"median_first_door_min\">First door (median min)</th>\n          <th data-field=\"mean_cost\">Mean cost ($)</th>\n          <th data-field=\"mean_tests\">Mean tests</th>\n        </tr></thead>\n        <tbody data-draw=\"model-rows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"pdb-section\" id=\"progress\">\n    <h2>How each run improved</h2>\n    <p>Each line is one run's best working door so far, as a score. It starts at the run's first working door and steps up at each improvement. Dots mark tests that improved the door.</p>\n    <div class=\"pdb-controls\">\n      <label for=\"pdb-x\">Measure progress against</label>\n      <select class=\"dash-select\" id=\"pdb-x\" aria-label=\"Horizontal axis\">\n        <option value=\"minutes\">Minutes since the first tool call</option>\n        <option value=\"cost\">API-equivalent cost so far ($)</option>\n        <option value=\"test\">Test calls</option>\n      </select>\n      <div class=\"pdb-legend\" aria-hidden=\"true\">\n        <span><i class=\"pdb-sw\" data-model=\"0\"></i>Fable 5.2</span>\n        <span><i class=\"pdb-sw\" data-model=\"1\"></i>Opus 5.5</span>\n        <span><i class=\"pdb-sw\" data-model=\"2\"></i>Sonnet 5.5</span>\n        <span><i class=\"pdb-sw\" data-model=\"3\"></i>Haiku 5.5</span>\n      </div>\n    </div>\n    <div class=\"pdb-panels\" data-draw=\"curves\" data-source=\"curve runs\"></div>\n  </section>\n\n  <section class=\"pdb-section\" id=\"cost\">\n    <h2>Final score against total cost</h2>\n    <p>One dot per run. Up is a smaller door, right is more spent.</p>\n    <div class=\"pdb-panels\" data-draw=\"scatter\" data-source=\"runs\"></div>\n  </section>\n\n  <section class=\"pdb-section\" id=\"runs\">\n    <h2>Every run</h2>\n    <div class=\"pdb-scroll\">\n      <table data-source=\"runs\" data-row-key=\"run\" aria-label=\"Every run\">\n        <thead><tr>\n          <th class=\"pdb-l\" data-field=\"run\">Run</th>\n          <th class=\"pdb-l\" data-field=\"task\">Task</th>\n          <th class=\"pdb-l\" data-field=\"model\">Model</th>\n          <th class=\"pdb-l\" data-field=\"status\">Result</th>\n          <th data-field=\"volume\">Volume</th>\n          <th data-field=\"dims\">Size (w\u00d7h\u00d7d)</th>\n          <th data-field=\"score\">Score</th>\n          <th data-field=\"placements\">Placements passed</th>\n          <th data-field=\"first_door_min\">First door (min)</th>\n          <th data-field=\"cost\">Cost ($)</th>\n          <th data-field=\"tests\">Tests</th>\n          <th data-field=\"lab_ticks\">Lab ticks</th>\n          <th data-field=\"rounds\">Rounds</th>\n        </tr></thead>\n        <tbody data-draw=\"run-rows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <details id=\"notes\">\n    <summary>What the numbers mean, and what to keep in mind</summary>\n    <ul>\n      <li><b>Volume</b> is the width \u00d7 height \u00d7 depth of the smallest box holding every block the door used at any moment, moving parts and the doorway included. The lever's cell is not counted.</li>\n      <li><b>Reference volumes</b>: 3\u00d73 seamless 192 (the best door this grader had seen before the benchmark), 2\u00d72 seamless 30, 4\u00d74 seamless 132 (a community claim, not yet rebuilt in this grader).</li>\n      <li><b>Working door</b> means it passed the final test: eight open and close cycles at varied moments in a fresh simulator. <b>Placements passed</b> is how many of 11 shifted and half-turned copies of the same door still work; it does not change the score.</li>\n      <li><b>First door</b> is the time from the agent's first tool call to its first test that passed. <b>Rounds</b> counts the first attempt plus each \"keep going\" message.</li>\n      <li>Each cell is one or two runs, so differences between neighbouring models are not yet statistically settled.</li>\n      <li>Costs come from the token counts in each agent's transcript at Claude API list prices. They are not what was billed. Haiku 5.5's cache-read price is not in the price list used, so it is assumed to be a tenth of its input price.</li>\n      <li>Two runs were stopped by the harness: w1-haiku-b at about minute 26, after it stopped calling tools for over 20 minutes, and w3-sonnet-c when it passed its 120-minute limit.</li>\n      <li>The machine running the benchmark slept from 03:25 to 09:21 on 13 November with eight runs in progress. That window is left out of every run's minutes, and the runs carried on after it. w2-4x4-fable-b was wrongly refused for time at the wake, told what happened, and given its remaining time back.</li>\n      <li>Fable's 70-volume 3\u00d73 door hangs its lever one block off the door's plane. The rules do not count the lever's cell, so this is allowed.</li>\n      <li>Two agents reached outside their working folder: one created and deleted an empty file in /tmp, one was blocked from writing there. Neither touched the grader.</li>\n      <li>The task brief was frozen for the whole benchmark. Facts the agents found missing are listed for the next version and not added.</li>\n    </ul>\n  </details>\n</div>\n\n<script>\n  window.pdbModels = ['Fable 5.2', 'Opus 5.5', 'Sonnet 5.5', 'Haiku 5.5'];\n  window.pdbColor = (m) => dash.colors[Math.max(0, window.pdbModels.indexOf(m)) % dash.colors.length];\n  window.pdbNum = (v, d) => (v === null || v === undefined || v === '' || Number.isNaN(+v)) ? null : +(+v).toFixed(d);\n\n  function median(xs) {\n    const v = xs.filter((x) => x !== null && x !== undefined).map(Number).sort((a, b) => a - b);\n    if (!v.length) return null;\n    const m = Math.floor(v.length / 2);\n    return v.length % 2 ? v[m] : (v[m - 1] + v[m]) / 2;\n  }\n  function mean(xs) {\n    const v = xs.filter((x) => x !== null && x !== undefined).map(Number);\n    return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null;\n  }\n\n  dash.calc('byModel', {\n    title: 'Results by model and task',\n    description: 'Per task and model: runs, working doors, best and mean score, median minutes to the first working door, mean cost and mean test calls.',\n    inputs: ['runs'],\n    fn: (runs) => {\n      const groups = d3.groups(runs, (r) => r.task, (r) => r.model);\n      const out = [];\n      for (const [task, models] of groups) {\n        for (const [model, rs] of models) {\n          const doors = rs.filter((r) => r.status === 'door');\n          out.push({\n            task, model, runs: rs.length, doors: doors.length,\n            best_volume: doors.length ? d3.min(doors, (r) => +r.volume) : null,\n            best_score: rs.some((r) => r.score !== null) ? +d3.max(rs, (r) => +(r.score || 0)).toFixed(3) : null,\n            mean_score: rs.some((r) => r.score !== null) ? +mean(rs.map((r) => r.score === null ? null : +r.score)).toFixed(3) : null,\n            median_first_door_min: median(rs.map((r) => r.first_door_min)) === null ? null : +median(rs.map((r) => r.first_door_min)).toFixed(1),\n            mean_cost: +mean(rs.map((r) => r.cost)).toFixed(2),\n            mean_tests: +mean(rs.map((r) => r.tests)).toFixed(1),\n          });\n        }\n      }\n      const order = (m) => window.pdbModels.indexOf(m);\n      return out.sort((a, b) => d3.ascending(a.task, b.task) || order(a.model) - order(b.model));\n    },\n  });\n\n  dash.calc('lead', {\n    title: 'Headline: 3\u00d73 seamless leader',\n    description: 'The smallest working 3\u00d73 seamless door, who built it, its score against the 192 reference, and which models built no working door.',\n    inputs: ['runs'],\n    fn: (runs) => {\n      const rs = runs.filter((r) => r.task === '3\u00d73 seamless');\n      const doors = rs.filter((r) => r.status === 'door');\n      if (!doors.length) return [];\n      const best = doors.reduce((a, b) => (+b.volume < +a.volume ? b : a));\n      const none = window.pdbModels.filter((m) => rs.some((r) => r.model === m) && !doors.some((r) => r.model === m));\n      return [{\n        model: best.model, volume: +best.volume, score: +(+best.score).toFixed(2),\n        no_door: none.length ? `${none.join(' and ')} built no working door.` : 'Every model built a working door.',\n      }];\n    },\n  });\n</script>\n\n<script>\n  // Legend swatches take the series colors; the select only triggers a redraw.\n  dash.onData(() => {\n    document.querySelectorAll('.pdb-sw[data-model]').forEach((el) => { el.style.background = dash.colors[+el.dataset.model % dash.colors.length]; });\n  });\n  document.querySelectorAll('#pdb-x').forEach((sel) => sel.addEventListener('change', () => dash.draw('curves')));\n\n  function leadField(el, field, fmt) {\n    const d = dash.data('lead');\n    const row = d.status === 'ok' && d.data && d.data[0];\n    el.textContent = row ? fmt(row[field]) : '\u2014';\n  }\n  dash.draw('lead-volume', (el) => leadField(el, 'volume', (v) => d3.format(',')(v)));\n  dash.draw('lead-model', (el) => leadField(el, 'model', (v) => v));\n  dash.draw('lead-score', (el) => leadField(el, 'score', (v) => d3.format('.2f')(v)));\n  dash.draw('lead-none', (el) => leadField(el, 'no_door', (v) => v));\n\n  const fmt = { int: d3.format(','), f1: d3.format('.1f'), f2: d3.format('.2f'), f3: d3.format('.3f') };\n  function cell(tr, value, cls) {\n    const td = tr.appendChild(document.createElement('td'));\n    if (cls) td.className = cls;\n    td.textContent = value === null || value === undefined || value === '' ? '\u2013' : value;\n    return td;\n  }\n\n  dash.draw('model-rows', (tbody) => {\n    const d = dash.data('byModel');\n    tbody.replaceChildren();\n    if (d.status !== 'ok' || !Array.isArray(d.data)) return;\n    for (const r of d.data) {\n      const tr = tbody.appendChild(document.createElement('tr'));\n      tr.dataset.key = `${encodeURIComponent(r.task)},${encodeURIComponent(r.model)}`;\n      cell(tr, r.task, 'pdb-l');\n      const m = tr.appendChild(document.createElement('td'));\n      m.className = 'pdb-l';\n      const sw = m.appendChild(document.createElement('i'));\n      sw.className = 'pdb-sw';\n      sw.style.background = window.pdbColor(r.model);\n      m.appendChild(document.createTextNode(r.model));\n      cell(tr, r.runs);\n      cell(tr, r.doors);\n      cell(tr, r.best_volume === null ? null : fmt.int(r.best_volume));\n      cell(tr, r.best_score === null ? null : fmt.f2(r.best_score));\n      cell(tr, r.mean_score === null ? null : fmt.f2(r.mean_score));\n      cell(tr, r.median_first_door_min === null ? null : fmt.f1(r.median_first_door_min));\n      cell(tr, r.mean_cost === null ? null : fmt.f2(r.mean_cost));\n      cell(tr, r.mean_tests === null ? null : fmt.f1(r.mean_tests));\n    }\n  });\n\n  dash.draw('run-rows', (tbody) => {\n    const d = dash.data('runs');\n    tbody.replaceChildren();\n    if (d.status !== 'ok') return;\n    const order = (m) => window.pdbModels.indexOf(m);\n    const rows = [...d.data].sort((a, b) => d3.ascending(a.task, b.task) || order(a.model) - order(b.model) || d3.ascending(a.run, b.run));\n    for (const r of rows) {\n      const tr = tbody.appendChild(document.createElement('tr'));\n      tr.dataset.key = encodeURIComponent(r.run);\n      cell(tr, r.run, 'pdb-l');\n      cell(tr, r.task, 'pdb-l');\n      cell(tr, r.model, 'pdb-l');\n      cell(tr, r.status, 'pdb-l');\n      cell(tr, r.volume === null ? null : fmt.int(r.volume));\n      cell(tr, r.dims);\n      cell(tr, r.score === null ? null : fmt.f2(r.score));\n      cell(tr, r.placements);\n      cell(tr, r.first_door_min === null ? null : fmt.f1(r.first_door_min));\n      cell(tr, fmt.f2(r.cost));\n      cell(tr, r.tests);\n      cell(tr, fmt.int(r.lab_ticks));\n      cell(tr, r.rounds);\n    }\n  });\n\n  // Shared chart helpers: axes measured from their labels, tooltip kept inside the panel.\n  function frame(panel, width, height, x, y, xLabel) {\n    const svg = d3.select(panel).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${width} ${height}`).attr('role', 'img');\n    const gy = svg.append('g').attr('class', 'pdb-axis').call(d3.axisLeft(y).ticks(5).tickFormat(d3.format('.1f')));\n    let left = 8;\n    gy.selectAll('text').each(function () { left = Math.max(left, this.getComputedTextLength() + 14); });\n    const m = { top: 12, right: 14, bottom: 40, left };\n    x.range([m.left, width - m.right]);\n    y.range([height - m.bottom, m.top]);\n    gy.attr('transform', `translate(${m.left},0)`).call(d3.axisLeft(y).ticks(5).tickFormat(d3.format('.1f')));\n    svg.insert('g', ':first-child').attr('class', 'pdb-grid').attr('transform', `translate(${m.left},0)`)\n      .call(d3.axisLeft(y).ticks(5).tickSize(-(width - m.left - m.right)).tickFormat(''));\n    const ticks = Math.max(2, Math.floor((width - m.left - m.right) / 70));\n    svg.append('g').attr('class', 'pdb-axis').attr('transform', `translate(0,${height - m.bottom})`).call(d3.axisBottom(x).ticks(ticks));\n    svg.append('text').attr('class', 'pdb-reflabel').attr('x', (m.left + width - m.right) / 2).attr('y', height - 6).attr('text-anchor', 'middle').text(xLabel);\n    return { svg, m };\n  }\n  function tooltip(panel) {\n    const tip = panel.appendChild(document.createElement('div'));\n    tip.className = 'pdb-tip';\n    tip.hidden = true;\n    return {\n      show(event, lines) {\n        tip.replaceChildren(...lines.map(([text, muted]) => { const div = document.createElement('div'); if (muted) div.className = 'pdb-muted'; div.textContent = text; return div; }));\n        tip.hidden = false;\n        const box = panel.getBoundingClientRect();\n        const px = event.clientX - box.left, py = event.clientY - box.top;\n        const w = tip.offsetWidth, h = tip.offsetHeight;\n        tip.style.left = `${Math.max(4, Math.min(px + 12, box.width - w - 4))}px`;\n        tip.style.top = `${Math.max(4, py - h - 10)}px`;\n      },\n      hide() { tip.hidden = true; },\n    };\n  }\n  function refLine(svg, m, width, y) {\n    if (y.domain()[1] < 1) return;\n    svg.append('line').attr('class', 'pdb-ref').attr('x1', m.left).attr('x2', width - m.right).attr('y1', y(1)).attr('y2', y(1));\n    svg.append('text').attr('class', 'pdb-reflabel').attr('x', width - m.right).attr('y', y(1) - 4).attr('text-anchor', 'end').text('reference');\n  }\n  function failed(el, msg) {\n    const p = el.appendChild(document.createElement('p'));\n    p.className = 'pdb-failed';\n    p.textContent = msg;\n  }\n\n  dash.draw('curves', (el) => {\n    el.replaceChildren();\n    const c = dash.data('curve'), r = dash.data('runs');\n    if (c.status === 'error' || r.status === 'error') return failed(el, 'Failed to load');\n    if (c.status !== 'ok' || r.status !== 'ok') { el.textContent = '\u2014'; return; }\n    const xKey = (document.querySelector('#pdb-x') || {}).value || 'minutes';\n    const xLabel = { minutes: 'minutes since the first tool call', cost: 'API-equivalent cost so far ($)', test: 'test calls' }[xKey];\n    const runsBy = new Map(r.data.map((x) => [x.run, x]));\n    for (const [task, pts] of d3.groups(c.data, (p) => p.task).sort((a, b) => d3.ascending(a[0], b[0]))) {\n      const panel = el.appendChild(document.createElement('div'));\n      panel.className = 'pdb-panel';\n      const h = panel.appendChild(document.createElement('h3'));\n      h.textContent = task;\n      const width = Math.max(300, panel.clientWidth - 2 * 12), height = 250;\n      const series = d3.groups(pts.filter((p) => p.best !== null), (p) => p.run).map(([run, ps]) => ({ run, model: ps[0].model, ps: ps.sort((a, b) => a.test - b.test) }));\n      const taskRuns = r.data.filter((x) => x.task === task);\n      const xMax = xKey === 'minutes' ? d3.max(taskRuns, (x) => +x.minutes_limit) || d3.max(pts, (p) => +p.minutes)\n        : xKey === 'cost' ? d3.max(taskRuns, (x) => +x.cost) : d3.max(pts, (p) => +p.test);\n      const x = d3.scaleLinear().domain([0, (xMax || 1) * 1.02]).nice();\n      const y = d3.scaleLinear().domain([0, Math.max(1.2, (d3.max(pts, (p) => +p.score) || 0) * 1.08)]).nice();\n      const { svg, m } = frame(panel, width, height, x, y, xLabel);\n      svg.attr('aria-label', `${task}: best score over ${xLabel}, one line per run`);\n      refLine(svg, m, width, y);\n      const tip = tooltip(panel);\n      const line = d3.line().curve(d3.curveStepAfter).x((p) => x(+p[xKey])).y((p) => y(+p.score));\n      for (const s of series) {\n        const run = runsBy.get(s.run);\n        const end = run && xKey === 'minutes' ? Math.min(+run.minutes_limit, d3.max(s.ps, (p) => +p.minutes)) : null;\n        const pathPts = end !== null ? [...s.ps, { ...s.ps[s.ps.length - 1], minutes: end }] : s.ps;\n        svg.append('path').attr('d', line(pathPts)).attr('fill', 'none').style('stroke', window.pdbColor(s.model)).attr('stroke-width', 2).attr('stroke-linejoin', 'round');\n        const improved = s.ps.filter((p, i) => i === 0 || +p.best < +s.ps[i - 1].best);\n        svg.append('g').selectAll('circle').data(improved).join('circle')\n          .attr('cx', (p) => x(+p[xKey])).attr('cy', (p) => y(+p.score)).attr('r', 4)\n          .style('fill', window.pdbColor(s.model)).style('stroke', 'var(--color-panel)').attr('stroke-width', 1.5)\n          .on('pointerenter pointermove', (event, p) => tip.show(event, [\n            [`${p.run} \u00b7 ${p.model}`],\n            [`volume ${d3.format(',')(p.best)} \u00b7 score ${d3.format('.2f')(p.score)}`],\n            [`test ${p.test} \u00b7 ${d3.format('.1f')(p.minutes)} min \u00b7 $${d3.format('.2f')(p.cost)}`, true],\n          ]))\n          .on('pointerleave', () => tip.hide());\n      }\n      const none = taskRuns.filter((x) => x.status !== 'door').map((x) => x.run);\n      const note = panel.appendChild(document.createElement('p'));\n      note.className = 'pdb-note';\n      note.textContent = none.length ? `No working door: ${none.join(', ')}.` : `Every run built a working door.`;\n    }\n  });\n\n  dash.draw('scatter', (el) => {\n    el.replaceChildren();\n    const r = dash.data('runs');\n    if (r.status === 'error') return failed(el, 'Failed to load');\n    if (r.status !== 'ok') { el.textContent = '\u2014'; return; }\n    for (const [task, rs] of d3.groups(r.data.filter((x) => x.score !== null), (x) => x.task).sort((a, b) => d3.ascending(a[0], b[0]))) {\n      const panel = el.appendChild(document.createElement('div'));\n      panel.className = 'pdb-panel';\n      const h = panel.appendChild(document.createElement('h3'));\n      h.textContent = task;\n      const width = Math.max(300, panel.clientWidth - 2 * 12), height = 230;\n      const x = d3.scaleLinear().domain([0, (d3.max(rs, (d) => +d.cost) || 1) * 1.08]).nice();\n      const y = d3.scaleLinear().domain([0, Math.max(1.2, (d3.max(rs, (d) => +d.score) || 0) * 1.1)]).nice();\n      const { svg, m } = frame(panel, width, height, x, y, 'API-equivalent cost of the run ($)');\n      svg.attr('aria-label', `${task}: final score against cost, one dot per run`);\n      refLine(svg, m, width, y);\n      const tip = tooltip(panel);\n      svg.append('g').selectAll('circle').data(rs).join('circle')\n        .attr('cx', (d) => x(+d.cost)).attr('cy', (d) => y(+d.score)).attr('r', 5)\n        .style('fill', (d) => window.pdbColor(d.model)).style('stroke', 'var(--color-panel)').attr('stroke-width', 1.5)\n        .on('pointerenter pointermove', (event, d) => tip.show(event, [\n          [`${d.run} \u00b7 ${d.model}`],\n          [d.status === 'door' ? `volume ${d3.format(',')(d.volume)} \u00b7 score ${d3.format('.2f')(d.score)}` : 'no working door'],\n          [`$${d3.format('.2f')(d.cost)} \u00b7 ${d.tests} tests \u00b7 ${d.rounds} rounds`, true],\n        ]))\n        .on('pointerleave', () => tip.hide());\n    }\n  });\n</script>\n", "edit": {"via": "claude", "at": "2026-11-13T16:27:47Z"}}